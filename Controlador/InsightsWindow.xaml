<Window x:Class="Controlador.InsightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controlador — Insights"
        Width="700"
        Height="580"
        MinWidth="580"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>
            <TextBlock Text="📊 Insights" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Seus padrões de trabalho com base em todos os registros." Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Cards grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Row 1: summary cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="HORAS TOTAIS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TotalHoursText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="registradas no histórico" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="CHAMADOS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TotalTicketsText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="chamados distintos" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="SESSÕES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TotalSessionsText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="períodos registrados" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: averages + patterns -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="MÉDIAS (últimos 30 dias)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Horas/dia" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="AvgHoursPerDayText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Chamados/dia" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="AvgTicketsPerDayText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Sessões/dia" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="AvgSessionsPerDayText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Duração média/sessão" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="AvgSessionDurationText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="PADRÕES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Dia mais produtivo" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="BestDayText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Faixa mais ativa" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="PeakHourText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Horas esta semana" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="ThisWeekText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Horas semana passada" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="LastWeekText" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 3: Top tickets -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="TOP CHAMADOS — últimos 30 dias" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />
                        <ItemsControl x:Name="TopTicketsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Rank}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding SessionInfo}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoTicketsText" Text="Nenhum chamado registrado nos últimos 30 dias."
                                   Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
