<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackground"        Color="#1A1A1A" />
    <SolidColorBrush x:Key="CardBackground"       Color="#242424" />
    <SolidColorBrush x:Key="CardInnerBackground"  Color="#2A2A2A" />
    <SolidColorBrush x:Key="InputBackground"      Color="#2D2D2D" />

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandBlackBrush"      Color="#0D0D0D" />
    <SolidColorBrush x:Key="PrimaryBrush"         Color="#E03030" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"            Color="#EAEAEA" />
    <SolidColorBrush x:Key="MutedTextBrush"       Color="#999999" />
    <SolidColorBrush x:Key="InverseTextBrush"     Color="#FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"          Color="#3A3A3A" />
    <SolidColorBrush x:Key="InnerBorderBrush"     Color="#333333" />
    <SolidColorBrush x:Key="SubtleBorderBrush"    Color="#2F2F2F" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridLineBrush"    Color="#333333" />
    <SolidColorBrush x:Key="ListItemBackground"   Color="#2D2D2D" />
    <SolidColorBrush x:Key="ListItemBorderBrush"  Color="#3A3A3A" />

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayBorderBrush"   Color="#0A0A0A" />

</ResourceDictionary>
