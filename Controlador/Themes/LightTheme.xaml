<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackground"        Color="#F4F4F4" />
    <SolidColorBrush x:Key="CardBackground"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardInnerBackground"  Color="#FAFAFA" />
    <SolidColorBrush x:Key="InputBackground"      Color="#FFFFFF" />

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandBlackBrush"      Color="#141414" />
    <SolidColorBrush x:Key="PrimaryBrush"         Color="#D71920" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"            Color="#171717" />
    <SolidColorBrush x:Key="MutedTextBrush"       Color="#686868" />
    <SolidColorBrush x:Key="InverseTextBrush"     Color="#FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"          Color="#D9D9D9" />
    <SolidColorBrush x:Key="InnerBorderBrush"     Color="#E5E5E5" />
    <SolidColorBrush x:Key="SubtleBorderBrush"    Color="#EBEBEB" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridLineBrush"    Color="#E8E8E8" />
    <SolidColorBrush x:Key="ListItemBackground"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListItemBorderBrush"  Color="#E5E5E5" />

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayBorderBrush"   Color="#2A2A2A" />

</ResourceDictionary>
