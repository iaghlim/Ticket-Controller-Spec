<Window x:Class="Controlador.TimerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controlador — contador"
        Width="360"
        Height="275"
        MinWidth="280"
        MinHeight="85"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="TimerOverlayWindow_Loaded"
        Closing="TimerOverlayWindow_Closing">
    <Window.Resources>
        <Style x:Key="OverlayHeaderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BrandBlackBrush}" CornerRadius="9,9,0,0" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid Margin="12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="CONTROLADOR" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock x:Name="HeaderSubtitleText" Text="contador flutuante" Foreground="#CFCFCF" FontSize="9" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MiniModeToggleButton" Content="Mini" Style="{StaticResource OverlayHeaderButton}" ToolTip="Alternar modo mini compacto" Click="MiniModeToggleButton_Click" />
                        <Button Content="Abrir" Style="{StaticResource OverlayHeaderButton}" ToolTip="Abrir o aplicativo" Click="OpenMainButton_Click" />
                        <Button Content="Ocultar" Style="{StaticResource OverlayHeaderButton}" ToolTip="Ocultar na bandeja do Windows" Click="HideToTrayButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,10,14,12">
                <!-- Normal Mode View -->
                <Grid x:Name="NormalPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="IdleWarningBanner"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            Background="#FFF3CD"
                            BorderBrush="#FFEEBA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,4"
                            Margin="0,0,0,8">
                        <TextBlock Text="⚠️ Gravando há mais de 2 horas contínuas."
                                   Foreground="#856404"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="CurrentTicketText" Grid.Row="1" Text="Nenhum chamado ativo" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="TimerText" Grid.Row="2" Text="00:00:00" FontSize="32" FontWeight="SemiBold" Margin="0,1,0,0" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="TimerStatusText" Grid.Row="3" Text="Digite um chamado para começar." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" FontSize="12" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TicketCodeTextBox"
                                 FontSize="14"
                                 ToolTip="Digite o número do chamado e aperte Enter"
                                 KeyDown="TicketCodeTextBox_KeyDown" />
                        <Button x:Name="StartSwitchButton" Grid.Column="2" Content="Gravar" Click="StartSwitchButton_Click" />
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseResumeButton" Content="Pausar" Style="{StaticResource SecondaryButton}" Click="PauseResumeButton_Click" />
                        <Button Grid.Column="2" Content="Abrir app" Style="{StaticResource SecondaryButton}" Click="OpenMainButton_Click" />
                    </Grid>

                    <TextBlock x:Name="ValidationText"
                               Grid.Row="6"
                               Foreground="{DynamicResource PrimaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,8,0,0" />
                </Grid>

                <!-- Mini Mode View -->
                <Grid x:Name="MiniPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="MiniTicketText" Text="Nenhum chamado" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="MiniTimerText" Text="00:00:00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                    </StackPanel>

                    <Button x:Name="MiniPauseResumeButton" Grid.Column="1" Content="Pausar" Padding="10,6" Style="{StaticResource SecondaryButton}" Click="PauseResumeButton_Click" />
                    <Button Grid.Column="3" Content="⤢" ToolTip="Expandir janela" Padding="8,4" Style="{StaticResource SecondaryButton}" Click="MiniModeToggleButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
