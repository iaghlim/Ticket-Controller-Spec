<Window x:Class="Controlador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controlador — Blend IT"
        Height="840"
        Width="1360"
        MinHeight="680"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BrandBlackBrush}" BorderBrush="#141414" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="3" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Controlador" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{DynamicResource Loc_HeaderSubtitle}" Foreground="#D9D9D9" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector -->
                    <ComboBox x:Name="LanguageComboBox" Width="70" Margin="0,0,8,0" SelectionChanged="LanguageComboBox_SelectionChanged"
                              Background="#2A2A2A" Foreground="White" BorderBrush="#444" ToolTip="Idioma / Language / Idioma">
                        <ComboBoxItem Content="PT" Tag="pt" IsSelected="True" />
                        <ComboBoxItem Content="EN" Tag="en" />
                        <ComboBoxItem Content="ES" Tag="es" />
                    </ComboBox>

                    <Button Content="{DynamicResource Loc_Timer}" Click="ShowTimerOverlayButton_Click" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Loc_Insights}" Click="ShowInsightsButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Background="#2A2A2A" Foreground="White" BorderBrush="#444" />
                    <Button x:Name="ThemeToggleButton" Content="🌙" Click="ThemeToggleButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Background="#2A2A2A" Foreground="White" BorderBrush="#444" ToolTip="Alternar modo escuro" Width="38" />
                    <Button Content="{DynamicResource Loc_ExportBackup}" Style="{StaticResource SecondaryButton}" Click="ExportBackupButton_Click" Margin="0,0,8,0"
                            Background="#2A2A2A" Foreground="White" BorderBrush="#444" />
                    <Button Content="{DynamicResource Loc_ImportBackup}" Style="{StaticResource SecondaryButton}" Click="ImportBackupButton_Click" Margin="0,0,8,0"
                            Background="#2A2A2A" Foreground="White" BorderBrush="#444" />
                    <Button Content="{DynamicResource Loc_OpenDataFolder}" Style="{StaticResource SecondaryButton}" Click="OpenDataFolderButton_Click"
                            Background="#2A2A2A" Foreground="White" BorderBrush="#444" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="395" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Timer card -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource Loc_Now}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="CurrentTicketText" Grid.Row="1" Text="{DynamicResource Loc_NoActiveTicket}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="TimerText" Grid.Row="2" Text="00:00:00" FontSize="34" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="TimerStatusText" Grid.Row="3" Text="{DynamicResource Loc_TypeTicketToStart}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,16" />

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Loc_TicketNumber}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />

                            <!-- Ticket input with autocomplete -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <TextBox x:Name="TicketInputTextBox"
                                         FontSize="16"
                                         ToolTip="Digite o chamado e pressione Enter"
                                         KeyDown="TicketInputTextBox_KeyDown"
                                         TextChanged="TicketInput_TextChanged"
                                         LostFocus="TicketInput_LostFocus" />
                                <Popup x:Name="TicketSuggestionsPopup"
                                       PlacementTarget="{Binding ElementName=TicketInputTextBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MaxHeight="220"
                                            MinWidth="355">
                                        <ListBox x:Name="TicketSuggestionsList"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 SelectionChanged="TicketSuggestionsList_SelectionChanged"
                                                 PreviewKeyDown="TicketSuggestionsList_PreviewKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="6,4">
                                                        <TextBlock Text="{Binding StarIcon}" Foreground="#F0AD00" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StartSwitchButton" Content="{DynamicResource Loc_StartTicket}" Click="StartSwitchButton_Click" />
                                <Button x:Name="PauseResumeButton" Grid.Column="2" Content="{DynamicResource Loc_Pause}" Style="{StaticResource SecondaryButton}" Click="PauseResumeButton_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Quick note card -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Loc_QuickNote}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="QuickNoteTextBox"
                                 Grid.Row="1"
                                 Margin="0,8,0,8"
                                 MinHeight="62"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 ToolTip="A nota será vinculada ao chamado ativo; se não houver um, ao chamado selecionado." />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc_NoteAutoTime}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="VoiceNoteButton" Grid.Column="1" Content="{DynamicResource Loc_RecordVoice}" Click="VoiceNoteButton_Click"
                                    Style="{StaticResource SecondaryButton}" Padding="10,7"
                                    ToolTip="Gravar nota de voz vinculada ao chamado" />
                            <Button Grid.Column="3" Content="{DynamicResource Loc_AddNote}" Click="AddQuickNoteButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Ticket list card -->
                <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Loc_TicketRepository}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="TicketSearchTextBox" Grid.Row="1" Margin="0,8,0,10" ToolTip="Buscar chamado" TextChanged="TicketSearchTextBox_TextChanged" />
                        <ListBox x:Name="TicketList" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="TicketList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,3" Background="{DynamicResource ListItemBackground}" BorderBrush="{DynamicResource ListItemBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StarIcon}" Foreground="#F0AD00" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- History summary card -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_HistoryView}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="PeriodDescriptionText" Text="Hoje" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Loc_Period}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                <ComboBox x:Name="PeriodPresetComboBox" Width="145" Margin="0,4,0,0" SelectionChanged="PeriodPresetComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Loc_PresetToday}" Tag="today" IsSelected="True" />
                                    <ComboBoxItem Content="{DynamicResource Loc_PresetWeek}" Tag="week" />
                                    <ComboBoxItem Content="{DynamicResource Loc_PresetMonth}" Tag="month" />
                                    <ComboBoxItem Content="{DynamicResource Loc_PresetCustom}" Tag="custom" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{DynamicResource Loc_FromUntil}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <DatePicker x:Name="PeriodStartDatePicker" Width="118" SelectedDateChanged="PeriodDatePicker_SelectedDateChanged" />
                                    <TextBlock Text="{DynamicResource Loc_Until}" VerticalAlignment="Center" Margin="7,0" Foreground="{DynamicResource MutedTextBrush}" />
                                    <DatePicker x:Name="PeriodEndDatePicker" Width="118" SelectedDateChanged="PeriodDatePicker_SelectedDateChanged" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="5" Content="{DynamicResource Loc_Apply}" Padding="12,7" VerticalAlignment="Bottom" Click="ApplyPeriodFilterButton_Click" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="PeriodTitleText" Text="HOJE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="TodayTotalText" Text="00:00:00" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="PeriodHoursCaptionText" Text="{DynamicResource Loc_TimeRegistered}" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CHAMADOS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="TodayTicketCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="PeriodTicketsCaptionText" Text="{DynamicResource Loc_TicketsUsed}" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SESSÕES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="TodaySessionCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="PeriodSessionsCaptionText" Text="{DynamicResource Loc_SessionsInPeriod}" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource Loc_CopyTimesheet}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CopyTimesheetButton_Click" ToolTip="Copiar resumo do período formatado para o timesheet" />
                                <Button Content="{DynamicResource Loc_ExportCsv}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportCsvButton_Click" ToolTip="Exportar sessões do período como CSV" />
                                <Button Content="{DynamicResource Loc_FinishDay}" Style="{StaticResource SecondaryButton}" Click="FinishDayButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sessions grid card -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PeriodSummaryTitleText" Text="{DynamicResource Loc_PeriodSessionsTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{DynamicResource Loc_EditSession}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="EditSelectedSessionButton_Click" Margin="0,0,6,0" />
                                <Button Content="{DynamicResource Loc_DeleteSession}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="DeleteSelectedSessionButton_Click" />
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="TodayEntriesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chamado" Binding="{Binding TicketCode}" Width="*" />
                                <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="105" />
                                <DataGridTextColumn Header="Início" Binding="{Binding StartedAt}" Width="110" />
                                <DataGridTextColumn Header="Fim" Binding="{Binding EndedAt}" Width="120" />
                                <DataGridTextColumn Header="Duração" Binding="{Binding Duration}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Ticket details card -->
                <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <TextBlock x:Name="NoTicketSelectedText"
                                   Text="{DynamicResource Loc_SelectTicketPrompt}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="430" />

                        <ScrollViewer x:Name="TicketDetailsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SelectedTicketCodeText" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <Button x:Name="FavoriteToggleButton"
                                                    Content="☆"
                                                    FontSize="18"
                                                    Style="{StaticResource SecondaryButton}"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Margin="8,0,0,0"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Fixar como favorito"
                                                    Click="FavoriteToggleButton_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="SelectedTicketStatsText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Loc_ExportReport}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportTicketReportButton_Click" ToolTip="Copiar dossiê completo do chamado em Markdown" />
                                        <Button Content="{DynamicResource Loc_DeleteTicket}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DeleteSelectedTicketButton_Click" Foreground="{DynamicResource PrimaryBrush}" />
                                        <Button Content="{DynamicResource Loc_SaveDocs}" Click="SaveDocumentationButton_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Documents + Attachments with Drag & Drop -->
                                <Border x:Name="DocumentDropArea"
                                        Background="{DynamicResource CardInnerBackground}"
                                        BorderBrush="{DynamicResource InnerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,16"
                                        AllowDrop="True"
                                        DragEnter="DocumentDropArea_DragEnter"
                                        DragLeave="DocumentDropArea_DragLeave"
                                        DragOver="DocumentDropArea_DragOver"
                                        Drop="DocumentDropArea_Drop">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_ExpectedDocsTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="{DynamicResource Loc_ExpectedDocsDesc}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,10" />
                                            <ListBox x:Name="DocumentRequirementsList" BorderBrush="{DynamicResource InnerBorderBrush}" BorderThickness="1" Background="{DynamicResource CardBackground}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" Margin="0,0,0,5" />
                                                                        <Button Content="{DynamicResource Loc_AttachFile}" Tag="{Binding DocumentType}" Click="AttachDocumentButton_Click" Padding="10,6" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,9,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource CardInnerBackground}" BorderBrush="{DynamicResource InnerBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,5">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="8" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                                                        <TextBlock Text="{Binding Metadata}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                    <Button Grid.Column="1" Content="{DynamicResource Loc_OpenFile}" Tag="{Binding AttachmentId}" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="OpenAttachmentButton_Click" />
                                                                                    <Button Grid.Column="3" Content="{DynamicResource Loc_RemoveFile}" Tag="{Binding AttachmentId}" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="RemoveAttachmentButton_Click" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>

                                        <!-- Drag overlay -->
                                        <Border x:Name="DragDropOverlay"
                                                Background="#CC2196F3"
                                                CornerRadius="8"
                                                Visibility="Collapsed">
                                            <TextBlock Text="{DynamicResource Loc_DragOverlayText}"
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource Loc_ContextLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBox x:Name="ContextTextBox" Margin="0,6,0,14" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Loc_AnalysisLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                    <Button Content="+ Template" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" HorizontalAlignment="Right" Click="InsertAnalysisTemplateButton_Click" ToolTip="Inserir estrutura padrão de análise técnica" />
                                </Grid>
                                <TextBox x:Name="AnalysisTextBox" Margin="0,0,0,14" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                                <TextBlock Text="{DynamicResource Loc_ActionsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBox x:Name="ActionsTextBox" Margin="0,6,0,14" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Loc_SolutionLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                    <Button Content="+ Template" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" HorizontalAlignment="Right" Click="InsertSolutionTemplateButton_Click" ToolTip="Inserir estrutura padrão de solução" />
                                </Grid>
                                <TextBox x:Name="SolutionTextBox" Margin="0,0,0,14" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource Loc_TestsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                    <Button Content="+ Template" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" HorizontalAlignment="Right" Click="InsertTestsTemplateButton_Click" ToolTip="Inserir roteiro de testes e evidências" />
                                </Grid>
                                <TextBox x:Name="TestsTextBox" Margin="0,0,0,14" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                                <TextBlock Text="{DynamicResource Loc_PendingLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBox x:Name="PendingTextBox" Margin="0,6,0,16" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                                <TextBlock Text="{DynamicResource Loc_NotesHistory}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,8" />
                                <ListBox x:Name="NotesList" BorderBrush="{DynamicResource InnerBorderBrush}" BorderThickness="1" MaxHeight="190" Background="{DynamicResource CardBackground}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock x:Name="FooterStatusText" Text="{DynamicResource Loc_FooterText}" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
    </Grid>
</Window>
